.git
.gitignore

# Keep local credentials, data, and caches out of every build context/stage.
.env
.env.*
!.env.example
.gradle/
bin/
uploads/
mariadb_data/
redis_data/
.aws/
.codex/
.agents/

# IDE 설정
*.iml
.idea/
.vscode/

# 빌드 결과물
out/
*.class

# OS/Editor 불필요 파일
.DS_Store
Thumbs.db

# Python 캐시
**/__pycache__/

# Dockerfile 자체 무시 (빌드에는 포함되지만 COPY 등에 사용되지 않도록)
Dockerfile
