# Local only: copy to .env. These are examples, not real secrets.
# Docker: docker compose -f docker-compose.local.yml up -d --build
# IDE: Java 17, repository root as working directory, --spring.profiles.active=local
# Format: KEY=value, no quotes/export; avoid backslashes, $, # and multiline values.

# MariaDB: IDE connects to localhost; Compose overrides DB_URL to db:3306.
DB_PORT=13306
DB_URL=jdbc:mariadb://localhost:13306/OpenCloset?sslMode=disable
DB_USERNAME=opencloset
DB_PASSWORD=change-me-local-db-password
DB_ROOT_PASSWORD=change-me-local-root-password

# Redis: IDE connects to localhost; Compose overrides REDIS_HOST to redis.
REDIS_HOST=localhost
REDIS_PORT=6379

# Docker host port for the application. IDE uses 8080 by default.
APP_PORT=8080

# Optional integrations: dummy values allow startup, but do not enable these features.
# Email uses the existing sender in application.properties; set its app password here.
EMAIL_PASSWORD=not-configured-local-only

# For real Kakao login, replace with your REST API key / client secret and register
# this exact redirect URI in Kakao Developers. Adjust the URI if APP_PORT changes.
KAKAO_CLIENT_ID=local-not-configured
KAKAO_CLIENT_SECRET=local-not-configured
KAKAO_REDIRECT_URI=http://localhost:8080/auth/kakao/callback
